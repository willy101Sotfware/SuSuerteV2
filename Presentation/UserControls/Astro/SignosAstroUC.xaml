                <Image Source="/Images/Buttons/sagitario_selec.png" x:Name="sagitarioselect" Visibility="Hidden" Tag="sagitario" MouseDown="ImageSelect_MouseDown"  Height="200"  Width="200" Margin="717,510,163,310" />
                <Image Source="/Images/Buttons/capricornio_selec.png" x:Name="capricornioselect" Visibility="Hidden" Tag="capricornio" MouseDown="ImageSelect_MouseDown" Height="200"  Width="200" Margin="163,762,717,58" />
                <Image Source="/Images/Buttons/acuario_selec.png" x:Name="acuarioselect" Visibility="Hidden" Tag="acuario" MouseDown="ImageSelect_MouseDown" Height="200"  Width="200" Margin="439,762,441,58" />
                <Image Source="/Images/Buttons/piscis_selec.png" x:Name="piscisselect" Visibility="Hidden" Tag="piscis" MouseDown="ImageSelect_MouseDown"  Height="200"  Width="200" Margin="718,762,162,58" />


            </Grid>

            <Grid Grid.Row="2">

                <Image Source="/Images/Buttons/btnCancelar.png" 
                  
                   HorizontalAlignment="Left"
                   TouchDown="Btn_CancelarTouchDown"
                   VerticalAlignment="Top" Height="101" Width="346" Margin="129,43,0,0"/>

                <Image Source="/Images/Buttons/btnContinuar.png" 
                  
                   TouchDown="Btn_ContinuarTouchDown"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top" Height="101" Width="346" Margin="610,47,0,0"/>


                <Image Source="/Images/Others/ico_atencion_cliente.png"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top" Height="114" Width="710" Margin="0,247,0,0"/>
            </Grid>
        </Grid>
    </Viewbox>
</local:AppUserControl>
