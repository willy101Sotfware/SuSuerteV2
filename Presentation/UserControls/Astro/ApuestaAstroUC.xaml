                    Foreground="White"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top" Height="53" Width="89"/>

                <Image Source="/Images/Buttons/btnatras.png"
                       Margin="34,55,0,0"
                       HorizontalAlignment="Left"
                       TouchDown="BtnAtras"
                       VerticalAlignment="Top" Height="103" Width="92"/>

            </Grid>

            <Grid
                x:Name="mainContainer"
                Grid.Row="1" Margin="0,1,10,-1">


