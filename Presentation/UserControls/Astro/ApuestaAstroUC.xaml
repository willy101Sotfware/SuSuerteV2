                <Image Source="/Images/Others/txtnumeroajugar.png"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" Height="52" Width="397" Margin="340,-88,0,0" Grid.ColumnSpan="2"/>


                <Image Source="/Images/Others/InputNum.png"
                       Height="116" Width="116" Margin="393,90,561,1364"/>

                <Image Source="/Images/Others/InputNum.png"
                       Height="116" Width="116" Margin="530,90,424,1364"/>

                <Image Source="/Images/Others/InputNum.png"
