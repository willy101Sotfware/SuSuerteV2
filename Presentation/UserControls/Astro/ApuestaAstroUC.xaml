                <Image Source="/Images/Others/InputNum.png"
                       Height="116" Width="116" Margin="798,90,156,1364"/>

                <TextBox x:Name="Num1"
                         HorizontalAlignment="Left"
                         Margin="426,116,0,0"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         Text=""

                         GotFocus="Num1_GotFocus"
                         TextChanged="Num1_TextChanged"
                         VerticalAlignment="Top"
                         Width="50"
                         BorderBrush="{x:Null}"
                         Background="{x:Null}"
                         Foreground="Black"
                         TouchDown="Num1_GotFocus"
                         FontSize="50"
                         Height="65"/>

                <TextBox x:Name="Num2"
                         HorizontalAlignment="Left"
                         Margin="563,116,0,0"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         Text=""
                         GotFocus="Num2_GotFocus"
                         TextChanged="Num2_TextChanged"
                         VerticalAlignment="Top"
                         Width="50"
                         BorderBrush="{x:Null}"
