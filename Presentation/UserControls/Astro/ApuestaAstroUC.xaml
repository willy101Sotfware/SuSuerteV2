                       x:Name="imgLoteria2"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" Height="256" Width="190" Margin="113,26,0,0"/>
                <!--<Image Source="/Images/LoteriasS/LOTERIA QUINDIO.png"
                x:Name="imgLoteria"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" Height="256" Width="190" Margin="189,20,0,0"/>-->



            </Grid>

            <Image Source="/Images/Others/ico_atencion_cliente.png"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top" Height="114" Width="710" Margin="193,1446,0,0" Grid.Row="1"/>

        </Grid>
