                <Image Source="/Images/Backgrounds/BgValueA.png"
                       VerticalAlignment="Top" Height="134" Margin="306,710,306,0"/>
                <TextBox
                    HorizontalContentAlignment="Center"
                    Text="{Binding ValorDirecto, StringFormat=C0}"
                    Margin="306,738,306,0"
                    TextWrapping="Wrap"
                    VerticalContentAlignment="Center"
                    VerticalAlignment="Top"
                    x:Name="txtDirecto"
                    Width="458"
                    Height="74"
                    FontSize="45"
                    Background="Transparent"
                    Foreground="Black"
                    BorderBrush="Transparent"
                    SelectionBrush="Transparent"
                    IsReadOnly="True"
                    IsReadOnlyCaretVisible="false"/>





