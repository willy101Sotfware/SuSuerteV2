                         Margin="831,116,0,0"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         Text=""
                         GotFocus="Num4_GotFocus"
                         TextChanged="Num4_TextChanged"
                         VerticalAlignment="Top"
                         Width="50"
                         BorderBrush="{x:Null}"
                         Background="{x:Null}"
                         Foreground="Black"
                         FontSize="50"
                         TouchDown="Num4_GotFocus"
