                         VerticalAlignment="Top"
                         Width="50"
                         BorderBrush="{x:Null}"
                         Background="{x:Null}"
                         Foreground="Black"
                         TouchDown="Num3_GotFocus"
                         FontSize="50"
                         Height="65"/>

                <TextBox x:Name="Num4"
